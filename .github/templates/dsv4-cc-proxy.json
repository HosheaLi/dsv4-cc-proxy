{
    "version": "VERSION_PLACEHOLDER",
    "description": "Make DeepSeek V4 work flawlessly with Claude Code — Anthropic API compatibility proxy",
    "homepage": "https://github.com/HosheaLi/dsv4-cc-proxy",
    "license": "MIT",
    "url": "ZIP_URL_PLACEHOLDER",
    "extract_dir": "EXTRACT_DIR_PLACEHOLDER",
    "hash": "HASH_PLACEHOLDER",
    "pre_install": [
        "$venv = \"$dir\\venv\"",
        "python -m venv \"$venv\"",
        "& \"$venv\\Scripts\\python\" -m pip install \"$dir\""
    ],
    "bin": [
        [
            "venv\\Scripts\\dsv4-cc-proxy.exe",
            "dsv4-cc-proxy"
        ]
    ],
    "checkver": {
        "github": "https://github.com/HosheaLi/dsv4-cc-proxy"
    },
    "autoupdate": {
        "url": "https://github.com/HosheaLi/dsv4-cc-proxy/archive/refs/tags/v$version.zip",
        "extract_dir": "dsv4-cc-proxy-$version"
    }
}
